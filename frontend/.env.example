# CloudTenant — AWS Environment Configuration (Mumbai ap-south-1)
# Copy this to .env after running `sam deploy`
VITE_AWS_REGION=ap-south-1
VITE_API_BASE_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com/Prod
VITE_USER_POOL_ID=ap-south-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_ENABLE_MOCK_FALLBACK=true
